; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AfterHongHuang"
config/version="0.0.1-alpha"
config/tags=PackedStringArray("代码")
run/main_scene="res://scenes/Title/Title.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[autoload]

GameManager="*res://scripts/Core/GameManager.cs"
AudioSettingsService="*res://scripts/Core/AudioSettingsService.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="AfterHongHuang"

[editor_plugins]

enabled=PackedStringArray("res://addons/card_authoring/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
